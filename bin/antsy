#!/bin/sh
# Plugin shim: runs the real antsy binary. Installs nothing by itself.
root=$(cd "$(dirname "$0")/.." && pwd)
for b in "$ANTSY_BIN" "$HOME/.antsy/bin/antsy" "$root/target/release/antsy" "$HOME/.cargo/bin/antsy"; do
  if [ -n "$b" ] && [ -x "$b" ]; then exec "$b" "$@"; fi
done
if [ "$1" = hook ]; then
  if [ "$2" = session-start ]; then
    printf '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"The antsy plugin is installed but its binary is not. Install it with: sh %s/scripts/install.sh"}}\n' "$root"
  fi
  exit 0
fi
echo "antsy: binary not installed. Run: sh $root/scripts/install.sh" >&2
exit 127
